    <!-- Cable endpoint landing station: starting country -->
    <model name="station_country_A">
      <static>true</static>
      <pose>-40.9 1.0 2.9 0 0 0</pose>
      <link name="station_link">
        <collision name="station_base_collision">
          <geometry>
            <box>
              <size>2.8 2.8 5.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="station_base_visual">
          <geometry>
            <box>
              <size>2.8 2.8 5.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.42 0.62 1</ambient>
            <diffuse>0.10 0.42 0.62 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cable endpoint landing station: destination country -->
    <model name="station_country_B">
      <static>true</static>
      <pose>40.9 -0.1 2.9 0 0 0</pose>
      <link name="station_link">
        <collision name="station_base_collision">
          <geometry>
            <box>
              <size>2.8 2.8 5.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="station_base_visual">
          <geometry>
            <box>
              <size>2.8 2.8 5.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.64 0.36 0.08 1</ambient>
            <diffuse>0.64 0.36 0.08 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="stop_marker">
      <static>true</static>
      <pose>32.9099 2.0217 1.0000 0 0 0</pose>
      <link name="marker_link">
        <collision name="marker_collision">
          <geometry>
            <sphere>
              <radius>0.25</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="marker_visual">
          <geometry>
            <sphere>
              <radius>0.25</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1.0 0.85 0.10 1</ambient>
            <diffuse>1.0 0.85 0.10 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <emissive>0.35 0.30 0.05 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Underwater Cable Inspection Robot -->
    <model name="cable_repair_robot">
      <static>false</static>
      <!-- Start just outside Station A on the first outbound cable segment so
           the chassis is clear of the cable and already facing Station B. -->
      <pose>-38.40 1.07 3.43 0 0 0.43</pose>

      <link name="base_link">
        <!-- Realistic-ish underwater robot inertia -->
        <inertial>
          <mass>55.0</mass>
          <inertia>
            <ixx>2.2</ixx>
            <iyy>2.6</iyy>
            <izz>3.1</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <!-- Main body collision -->
        <collision name="body_collision">
          <geometry>
            <box>
              <size>1.0 0.62 0.30</size>
            </box>
          </geometry>
          <surface>
            <contact>
              <collide_bitmask>65535</collide_bitmask>
            </contact>
          </surface>
        </collision>

        <!-- Main body visual -->
        <visual name="body_visual">
          <geometry>
            <box>
              <size>1.0 0.62 0.30</size>
            </box>
          </geometry>
          <material>
            <ambient>0.08 0.24 0.85 1</ambient>
            <diffuse>0.08 0.24 0.85 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>

        <!-- Front camera sensor -->
        <sensor name="front_camera" type="camera">
          <!-- Point slightly downward so the cable stays in frame while the
               robot drives forward along the seabed cable. -->
          <pose>0.62 0 0.24 0 0.52 0</pose>
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <topic>/cable_repair_robot/camera</topic>
          <camera>
            <horizontal_fov>1.85</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>80</far>
            </clip>
          </camera>
        </sensor>

        <!-- IMU sensor (valid Gazebo sensor type) -->
        <sensor name="imu_sensor" type="imu">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <topic>/cable_repair_robot/imu</topic>
          <imu/>
        </sensor>

        <!-- Thruster visuals -->
        <visual name="thruster_left_visual">
          <pose>-0.46 0.26 -0.02 0 1.5708 0</pose>
          <geometry>
            <cylinder>
              <radius>0.07</radius>
              <length>0.16</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>

        <visual name="thruster_right_visual">
          <pose>-0.46 -0.26 -0.02 0 1.5708 0</pose>
          <geometry>
            <cylinder>
              <radius>0.07</radius>
              <length>0.16</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Optional small inspection arm -->
      <link name="repair_arm_link">
        <pose>0.47 0.08 -0.10 0 0 0</pose>
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.007</ixx>
            <iyy>0.007</iyy>
            <izz>0.002</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="arm_collision">
          <geometry>
            <box>
              <size>0.26 0.035 0.035</size>
            </box>
          </geometry>
        </collision>
        <visual name="arm_visual">
          <geometry>
            <box>
              <size>0.26 0.035 0.035</size>
            </box>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>

      <joint name="repair_arm_joint" type="revolute">
        <parent>base_link</parent>
        <child>repair_arm_link</child>
        <pose>0.34 0.08 -0.10 0 0 0</pose>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.2</lower>
            <upper>1.2</upper>
            <effort>20</effort>
            <velocity>1.0</velocity>
          </limit>
        </axis>
      </joint>

      <!-- ROS2/Gazebo command actuator:
           consumes /model/cable_repair_robot/cmd_vel and applies direct
           linear/angular velocity commands to the robot body. -->
      <plugin filename="/home/kousik/cable_robot_controller/build/libcable_robot_controller_twist.so"
              name="cable_robot_controller::TwistCmdController">
        <link_name>base_link</link_name>
        <cmd_topic>/model/cable_repair_robot/cmd_vel</cmd_topic>
        <inspection_complete_topic>/model/cable_repair_robot/inspection_complete</inspection_complete_topic>
        <stop_marker_name>stop_marker</stop_marker_name>
        <stop_marker_reach_distance>1.0</stop_marker_reach_distance>
        <cmd_timeout_sec>0.4</cmd_timeout_sec>
        <robot_cable_clearance>0.20</robot_cable_clearance>
        <robot_half_height>0.15</robot_half_height>
        <vertical_kp>1.4</vertical_kp>
        <vertical_deadband>0.015</vertical_deadband>
        <max_vertical_speed>0.25</max_vertical_speed>
        <vertical_smoothing_tau>0.45</vertical_smoothing_tau>
        <cable_map_refresh_sec>0.5</cable_map_refresh_sec>
      </plugin>

      <!-- Publish robot world coordinates / poses -->
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_sensor_pose>true</publish_sensor_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_nested_model_pose>true</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>false</static_publisher>
        <static_update_frequency>1</static_update_frequency>
      </plugin>
    </model>

  </world>
</sdf>
