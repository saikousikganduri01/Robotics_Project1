<?xml version="1.0"?>
<sdf version="1.9">
  <world name="ocean_world">

    <!-- Core Systems -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="/home/kousik/gz_current_plugin/build/libCurrentSystem.so"
            name="ocean_current_plugin::CurrentSystem">
      <!-- Keep a very weak ambient current in the scene while excluding the
           inspection robot and station assets. -->
      <model_name_regex>^(submarine_cable|debris.*|trash.*|bottle.*|can.*|crate.*)$</model_name_regex>
      <cable_model_name>submarine_cable</cable_model_name>
      <cable_segment_collision_regex>segment_collision_.*</cable_segment_collision_regex>

      <min_current_speed>0.015</min_current_speed>
      <max_current_speed>0.035</max_current_speed>
      <initial_current_speed>0.022</initial_current_speed>
      <initial_heading_rad>0.12</initial_heading_rad>

      <speed_time_constant>45.0</speed_time_constant>
      <heading_time_constant>60.0</heading_time_constant>
      <speed_noise_stddev>0.0025</speed_noise_stddev>
      <heading_noise_stddev>0.01</heading_noise_stddev>
      <vertical_noise_stddev>0.0004</vertical_noise_stddev>

      <linear_drag_coefficient>0.18</linear_drag_coefficient>
      <max_accel>0.015</max_accel>
      <cable_linear_drag_scale>0.04</cable_linear_drag_scale>

      <cable_force_scale>2.2</cable_force_scale>
      <cable_sway_amplitude>0.015</cable_sway_amplitude>
      <cable_sway_frequency>0.07</cable_sway_frequency>
      <cable_sway_damping>7.5</cable_sway_damping>
      <cable_max_force_per_segment>0.03</cable_max_force_per_segment>
      <cable_anchor_linear_stiffness>55.0</cable_anchor_linear_stiffness>
      <cable_anchor_linear_damping>180.0</cable_anchor_linear_damping>
      <cable_anchor_angular_stiffness>32.0</cable_anchor_angular_stiffness>
      <cable_anchor_angular_damping>70.0</cable_anchor_angular_damping>
      <cable_anchor_max_force>8.0</cable_anchor_max_force>
      <cable_anchor_max_torque>6.0</cable_anchor_max_torque>

      <discover_period_ms>1500</discover_period_ms>
      <publish_period_ms>250</publish_period_ms>
      <random_seed>17</random_seed>
    </plugin>

    <!-- Gravity -->
    <gravity>0 0 0</gravity>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <pose>0 0 20 0 0 0</pose>
      <direction>0 0 -1</direction>
      <diffuse>0.62 0.79 1.0 1</diffuse>
      <specular>0.14 0.22 0.32 1</specular>
    </light>

    <!-- Soft top light to suggest shallow-water illumination -->
    <light type="point" name="top_water_glow">
      <pose>0 0 24 0 0 0</pose>
      <diffuse>0.34 0.56 0.82 1</diffuse>
      <specular>0.08 0.14 0.2 1</specular>
      <attenuation>
        <range>120</range>
        <linear>0.01</linear>
        <constant>0.8</constant>
        <quadratic>0.0015</quadratic>
      </attenuation>
    </light>

    <!-- Scene -->
    <scene>
      <ambient>0.06 0.12 0.2 1</ambient>
      <background>0.03 0.09 0.18 1</background>
      <!-- Blue depth haze to create dark-to-light water feel -->
      <fog>
        <color>0.07 0.16 0.28 1</color>
        <type>linear</type>
        <start>10</start>
        <end>95</end>
      </fog>
    </scene>

    <!-- Sea surface reference -->
    <model name="sea_surface">
      <static>true</static>
      <pose>0 0 2.20 0 0 0</pose>
      <link name="surface_link">
        <visual name="surface_visual">
          <geometry>
            <box><size>90 90 0.04</size></box>
          </geometry>
          <transparency>0.55</transparency>
          <material>
            <ambient>0.22 0.46 0.70 0.35</ambient>
            <diffuse>0.22 0.46 0.70 0.35</diffuse>
            <specular>0.08 0.12 0.18 0.35</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Seafloor -->
    <model name="seafloor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>80 80 1</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>8.0</mu>
                <mu2>8.0</mu2>
                <slip1>0.001</slip1>
                <slip2>0.001</slip2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>5000000</kp>
                <kd>50000</kd>
                <min_depth>0.0005</min_depth>
                <max_vel>0.02</max_vel>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>80 80 1</size></box>
          </geometry>
          <material>
            <ambient>0.17 0.15 0.12 1</ambient>
            <diffuse>0.24 0.21 0.17 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="debug_center_box">
      <static>true</static>
      <pose>0 0 1 0 0 0</pose>
      <link name="debug_link">
        <collision name="debug_collision">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
        </collision>
        <visual name="debug_visual">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <emissive>0.2 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Rocks: irregular mixed-shape clusters -->
    <model name="rock1">
      <static>true</static>
      <pose>-30 -5 1.25 0.1 -0.2 0.3</pose>
      <link name="link"><inertial><mass>400</mass></inertial>
        <collision name="c1"><geometry><sphere><radius>0.88</radius></sphere></geometry></collision>
        <collision name="c2"><pose>0.58 0.18 0.14 0 0.2 0</pose><geometry><box><size>0.92 0.74 0.62</size></box></geometry></collision>
        <collision name="c3"><pose>-0.42 -0.26 0.25 0.1 0.4 0</pose><geometry><cylinder><radius>0.32</radius><length>0.78</length></cylinder></geometry></collision>
        <visual name="v1"><geometry><sphere><radius>0.90</radius></sphere></geometry><material><ambient>0.42 0.39 0.35 1</ambient><diffuse>0.42 0.39 0.35 1</diffuse></material></visual>
        <visual name="v2"><pose>0.56 0.21 0.12 0.2 -0.1 0.3</pose><geometry><box><size>0.95 0.72 0.60</size></box></geometry><material><ambient>0.46 0.42 0.37 1</ambient><diffuse>0.46 0.42 0.37 1</diffuse></material></visual>
        <visual name="v3"><pose>-0.40 -0.23 0.28 0.2 0.5 0.1</pose><geometry><cylinder><radius>0.34</radius><length>0.76</length></cylinder></geometry><material><ambient>0.38 0.35 0.32 1</ambient><diffuse>0.38 0.35 0.32 1</diffuse></material></visual>
      </link>
    </model>

    <model name="rock2">
      <static>true</static>
      <pose>-18 20 1.05 -0.2 0.15 -0.5</pose>
      <link name="link"><inertial><mass>360</mass></inertial>
        <collision name="c1"><geometry><box><size>1.45 1.05 0.84</size></box></geometry></collision>
        <collision name="c2"><pose>0.54 -0.18 0.28 0 0.3 0</pose><geometry><sphere><radius>0.48</radius></sphere></geometry></collision>
        <collision name="c3"><pose>-0.62 0.32 0.18 0.3 0 0.2</pose><geometry><box><size>0.68 0.52 0.58</size></box></geometry></collision>
        <visual name="v1"><geometry><box><size>1.42 1.02 0.82</size></box></geometry><material><ambient>0.45 0.41 0.36 1</ambient><diffuse>0.45 0.41 0.36 1</diffuse></material></visual>
        <visual name="v2"><pose>0.52 -0.14 0.27 0.2 0.1 0</pose><geometry><sphere><radius>0.50</radius></sphere></geometry><material><ambient>0.4 0.37 0.33 1</ambient><diffuse>0.4 0.37 0.33 1</diffuse></material></visual>
        <visual name="v3"><pose>-0.60 0.28 0.20 0.3 0.2 -0.2</pose><geometry><box><size>0.70 0.54 0.60</size></box></geometry><material><ambient>0.36 0.33 0.3 1</ambient><diffuse>0.36 0.33 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="rock3">
      <static>true</static>
      <pose>12 -25 1.45 0.25 -0.1 0.2</pose>
      <link name="link"><inertial><mass>420</mass></inertial>
        <collision name="c1"><geometry><sphere><radius>0.92</radius></sphere></geometry></collision>
        <collision name="c2"><pose>-0.58 0 0.10 0.1 0.4 0.2</pose><geometry><box><size>0.88 0.72 0.60</size></box></geometry></collision>
        <collision name="c3"><pose>0.46 0.35 0.30 0.4 0 0.5</pose><geometry><cylinder><radius>0.30</radius><length>0.72</length></cylinder></geometry></collision>
        <visual name="v1"><geometry><sphere><radius>0.95</radius></sphere></geometry><material><ambient>0.43 0.4 0.36 1</ambient><diffuse>0.43 0.4 0.36 1</diffuse></material></visual>
        <visual name="v2"><pose>-0.58 0.05 0.10 0.1 0.5 0.2</pose><geometry><box><size>0.92 0.75 0.62</size></box></geometry><material><ambient>0.37 0.35 0.31 1</ambient><diffuse>0.37 0.35 0.31 1</diffuse></material></visual>
        <visual name="v3"><pose>0.44 0.33 0.30 0.4 0.1 0.5</pose><geometry><cylinder><radius>0.31</radius><length>0.74</length></cylinder></geometry><material><ambient>0.47 0.43 0.38 1</ambient><diffuse>0.47 0.43 0.38 1</diffuse></material></visual>
      </link>
    </model>

    <model name="rock4">
