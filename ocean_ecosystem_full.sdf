    <model name="rock10"><static>true</static><pose>-12 -30 1.45 0.1 -0.2 0.3</pose><link name="link"><inertial><mass>400</mass></inertial><collision name="c1"><geometry><sphere><radius>0.82</radius></sphere></geometry></collision><collision name="c2"><pose>0.5 0.15 0.1 0 0.2 0</pose><geometry><box><size>0.84 0.68 0.58</size></box></geometry></collision><collision name="c3"><pose>-0.35 -0.2 0.2 0.1 0.4 0</pose><geometry><cylinder><radius>0.29</radius><length>0.70</length></cylinder></geometry></collision><visual name="v1"><geometry><sphere><radius>0.86</radius></sphere></geometry><material><ambient>0.42 0.39 0.35 1</ambient><diffuse>0.42 0.39 0.35 1</diffuse></material></visual><visual name="v2"><pose>0.48 0.18 0.08 0.2 -0.1 0.3</pose><geometry><box><size>0.88 0.70 0.58</size></box></geometry><material><ambient>0.46 0.42 0.37 1</ambient><diffuse>0.46 0.42 0.37 1</diffuse></material></visual><visual name="v3"><pose>-0.35 -0.2 0.22 0.2 0.5 0.1</pose><geometry><cylinder><radius>0.31</radius><length>0.68</length></cylinder></geometry><material><ambient>0.38 0.35 0.32 1</ambient><diffuse>0.38 0.35 0.32 1</diffuse></material></visual></link></model>

    <!-- Large terrain mountains placed away from cable / robot corridor -->
    <model name="mountain_corner_nw">
      <static>true</static>
      <pose>-35 35 0 0 0 0</pose>
      <link name="mountain_link">
        <inertial><mass>6500</mass></inertial>

        <collision name="base_skirt_collision">
          <pose>0 0 2.1 0 0 0</pose>
          <geometry><cone><radius>8.4</radius><length>4.2</length></cone></geometry>
        </collision>
        <collision name="main_spine_collision">
          <pose>0.4 -0.3 6.7 0.05 -0.06 0.18</pose>
          <geometry><cone><radius>4.8</radius><length>9.8</length></cone></geometry>
        </collision>
        <collision name="north_peak_collision">
          <pose>-1.4 2.1 8.4 -0.04 0.03 0.32</pose>
          <geometry><cone><radius>3.0</radius><length>6.2</length></cone></geometry>
        </collision>
        <collision name="south_peak_collision">
          <pose>2.0 -2.4 7.4 0.03 -0.08 -0.24</pose>
          <geometry><cone><radius>2.6</radius><length>5.4</length></cone></geometry>
        </collision>
        <collision name="west_ridge_collision">
          <pose>-4.9 0.9 2.4 0.06 0.14 0.2</pose>
          <geometry><box><size>5.8 2.2 2.9</size></box></geometry>
        </collision>
        <collision name="east_ridge_collision">
          <pose>4.8 -1.0 2.2 -0.05 0.11 -0.28</pose>
          <geometry><box><size>5.2 2.0 2.6</size></box></geometry>
        </collision>
        <collision name="terrace_left_collision">
          <pose>-2.6 -3.5 1.4 0.12 0.02 0.3</pose>
          <geometry><box><size>3.4 2.1 1.2</size></box></geometry>
        </collision>
        <collision name="terrace_right_collision">
          <pose>3.1 3.0 1.6 -0.08 0.1 -0.22</pose>
          <geometry><box><size>3.1 2.0 1.3</size></box></geometry>
        </collision>
        <collision name="talus_a_collision">
          <pose>-5.9 -2.7 0.95 0 0 0</pose>
          <geometry><sphere><radius>1.6</radius></sphere></geometry>
        </collision>
        <collision name="talus_b_collision">
          <pose>5.6 2.8 0.9 0 0 0</pose>
          <geometry><sphere><radius>1.5</radius></sphere></geometry>
        </collision>
        <collision name="mid_connector_a_collision">
          <pose>-1.1 0.6 4.6 0 0 0</pose>
          <geometry><sphere><radius>2.2</radius></sphere></geometry>
        </collision>
        <collision name="mid_connector_b_collision">
          <pose>1.6 -1.2 4.1 0 0 0</pose>
          <geometry><sphere><radius>2.0</radius></sphere></geometry>
        </collision>
        <collision name="mid_connector_c_collision">
          <pose>0.2 1.8 3.7 0 0 0</pose>
          <geometry><sphere><radius>1.8</radius></sphere></geometry>
        </collision>

        <visual name="base_skirt_visual">
          <pose>0 0 2.1 0 0 0</pose>
          <geometry><cone><radius>8.6</radius><length>4.3</length></cone></geometry>
          <material><ambient>0.20 0.20 0.21 1</ambient><diffuse>0.20 0.20 0.21 1</diffuse></material>
        </visual>
        <visual name="main_spine_visual">
          <pose>0.4 -0.3 6.7 0.05 -0.06 0.18</pose>
          <geometry><cone><radius>4.9</radius><length>10.0</length></cone></geometry>
          <material><ambient>0.24 0.24 0.25 1</ambient><diffuse>0.24 0.24 0.25 1</diffuse></material>
        </visual>
        <visual name="north_peak_visual">
          <pose>-1.4 2.1 8.4 -0.04 0.03 0.32</pose>
          <geometry><cone><radius>3.1</radius><length>6.3</length></cone></geometry>
