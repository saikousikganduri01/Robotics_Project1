        <visual name="v2"><pose>0.42 -0.34 0.24 0.2 0.1 0.2</pose><geometry><sphere><radius>0.42</radius></sphere></geometry><material><ambient>0.47 0.44 0.39 1</ambient><diffuse>0.47 0.44 0.39 1</diffuse></material></visual>
